{
	"$schema": "../gen/schemas/desktop-schema.json",
	"identifier": "default",
	"description": "Default capabilities granted to the Alto desktop main window.",
	"windows": ["main", "win-*"],
	"permissions": [
		"core:default",
		"core:window:default",
		"core:window:allow-close",
		"core:window:allow-destroy",
		"core:window:allow-create",
		"core:window:allow-set-focus",
		"core:window:allow-set-position",
		"core:window:allow-show",
		"core:webview:allow-create-webview-window",
		"core:webview:default",
		"core:event:default",
		"dialog:default",
		"dialog:allow-open",
		"dialog:allow-save",
		"fs:default",
		"fs:allow-read-file",
		"fs:allow-write-file",
		"updater:default"
	]
}
